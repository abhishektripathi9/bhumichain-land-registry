# ==============================================================================
# BHUMICHAIN POLYGON AMOY TESTNET ENVIRONMENT CONFIGURATION
# Network: Polygon Amoy Testnet (Proof of Stake) | Chain ID: 80002
# ==============================================================================

# 1. Public or Dedicated RPC Endpoint for Polygon Amoy
# Public Faucet / RPC: https://rpc-amoy.polygon.technology
# Alchemy Example: https://polygon-amoy.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
# Infura Example: https://polygon-amoy.infura.io/v3/YOUR_INFURA_PROJECT_ID
POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology

# 2. Deployer Private Key (64-character hex string without 0x prefix)
# IMPORTANT: Fund this address with free testnet POL/MATIC from https://faucet.polygon.technology/
PRIVATE_KEY=your_deployer_wallet_private_key_here

# 3. Polygonscan API Key for Automated Source Code Verification
# Get your free key at: https://polygonscan.com/myapikey
POLYGONSCAN_API_KEY=your_polygonscan_api_key_here

# 4. Optional Pinata Cloud IPFS Credentials
PINATA_API_KEY=your_pinata_api_key
PINATA_SECRET_KEY=your_pinata_secret_key
